# ==========================================
# 1. DATABASE CONFIURATION (SUPABASE)
# ==========================================
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
DB_USERNAME=postgres.[YOUR_PROJECT_REF]
DB_PASSWORD=your-super-secret-supabase-password

# ==========================================
# 2. VECTOR DATABASE (QDRANT CLOUD)
# ==========================================
QDRANT_URL=https://[your-cluster].ap-southeast-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ==========================================
# 3. LLM API KEYS (RAG & QUERY REWRITING)
# ==========================================
GROQ_API_KEY=your-groq-api-key-for-llama-3-1

# ==========================================
# 4. MICROSERVICES URL (KẾT NỐI JAVA VÀ PYTHON)
# ==========================================
# Cổng mặc định của Embedding Service (TV3 & TV4 sẽ gọi)
EMBEDDING_SERVICE_URL=http://localhost:8001/api/embed

# ==========================================
# 5. SECURITY & JWT (XÁC THỰC CHO JAVA)
# ==========================================
JWT_SECRET=TaoMotChuoiBase64NgauNhienDaiVaKhoDoanDeBaoMatJWTChoAnToan123!@#
JWT_EXPIRATION_MS=86400000 # 24 giờ
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 ngày

# ==========================================
# 6. MODAL.COM (TV5 - FINE-TUNING INFERENCE)
# ==========================================
# Modal.com deployed service endpoint
MODAL_API_URL=https://your-workspace--finetune-api.modal.run
